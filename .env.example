# Copy to .env (never commit .env). The service reads these variables at start-up.
# The full reference with defaults: docs/operations/configuration.md

# Storage
FDEOPS_DATABASE_URL=postgresql+psycopg://fdeops:CHANGE_ME@localhost:5432/fdeops
FDEOPS_ARTIFACTS_DIR=/data/artifacts
FDEOPS_REGISTRY_DIR=/data/releases
FDEOPS_TENANTS_DIR=tenants
FDEOPS_CONFIGS_DIR=configs

# API protection
FDEOPS_CORS_ORIGINS=
FDEOPS_RATE_PER_MINUTE=120
FDEOPS_EXPENSIVE_PER_MINUTE=10
FDEOPS_AUTH_FAILURES_PER_MINUTE=10
FDEOPS_MAX_BODY_BYTES=1000000

# Models (free only). Leave empty to use replay or the rule-based model.
OPENROUTER_API_KEY=
FDEOPS_LLM_API_KEY=

# Compose only
POSTGRES_PASSWORD=CHANGE_ME
